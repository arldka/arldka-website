---
import Layout from "@/layouts/Layout.astro";
import { useTranslations, localeStaticPaths, getLang, formatDate } from "@/i18n/ui";
import { getPostsByLang, splitId } from "@/lib/blog";
import { getRelativeLocaleUrl } from "astro:i18n";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = localeStaticPaths satisfies GetStaticPaths;

const lang = getLang(Astro.params);
const t = useTranslations(lang);

const posts = await getPostsByLang(lang);
---

<Layout title={t("blog.heading")}>
  <div class="container page-blog">
    <h1>{t("blog.heading")}</h1>

    {posts.length === 0 ? (
      <p class="empty">{t("blog.empty")}</p>
    ) : (
      <ul class="post-list" role="list">
        {posts.map((post) => {
          const { slug } = splitId(post.id);
          return (
            <li class="post-item">
              <a href={getRelativeLocaleUrl(lang, `blog/${slug}`, { normalizeLocale: false })} class="post-link">
                <span class="post-title">{post.data.title}</span>
                <span class="post-date">
                  {formatDate(post.data.pubDate, lang)}
                </span>
              </a>
              <p class="post-desc">{post.data.description}</p>
              <ul class="post-tags" role="list">
                {post.data.tags.map((tag) => <li><span class="tag">{tag}</span></li>)}
              </ul>
            </li>
          );
        })}
      </ul>
    )}
  </div>
</Layout>

<style>
  .page-blog {
    padding-top: var(--space-12);
    padding-bottom: var(--space-16);
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .post-list {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .post-item {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-6) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .post-item:first-child { border-top: 1px solid var(--color-border); }

  .post-link {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    text-decoration: none;
    color: var(--color-text);
  }

  .post-link:hover .post-title { color: var(--color-accent); }

  .post-title { font-weight: 600; font-size: 1.05rem; }

  .post-date {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-muted);
    flex-shrink: 0;
  }

  .post-desc { color: var(--color-text-muted); font-size: 0.9rem; }

  .post-tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .empty { color: var(--color-text-muted); }
</style>
